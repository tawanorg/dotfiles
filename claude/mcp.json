{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ],
      "env": {}
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "graphify": {
      "type": "http",
      "url": "https://api.graphify.com/mcp"
    },
    "docling": {
      "type": "stdio",
      "command": "docling-mcp-server",
      "args": [
        "conversion",
        "manipulation",
        "--transport",
        "stdio"
      ],
      "env": {
        "DOCLING_MCP_CONVERSION_MODE": "local"
      }
    }
  }
}
