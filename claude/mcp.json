{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ],
      "env": {}
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "graphify": {
      "type": "http",
      "url": "https://api.graphify.com/mcp"
    },
    "docling": {
      "type": "stdio",
      "command": "docling-mcp-server",
      "args": [
        "conversion",
        "manipulation",
        "--transport",
        "stdio"
      ],
      "env": {
        "DOCLING_MCP_CONVERSION_MODE": "local"
      }
    },
    "terraform": {
      "type": "stdio",
      "command": "terraform-mcp-server",
      "args": [
        "stdio"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "{{HOME}}/.local/share/fnm/aliases/default/bin/npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.8.0",
        "--categoryPerformance=false",
        "--categoryEmulation=false",
        "--usageStatistics=false",
        "--screenshotFormat=webp",
        "--screenshotMaxWidth=1280"
      ]
    },
    "gcloud": {
      "type": "stdio",
      "command": "{{HOME}}/.local/share/fnm/aliases/default/bin/npx",
      "args": [
        "-y",
        "@google-cloud/gcloud-mcp"
      ]
    }
  }
}
