# ═══════════════════════════════════════════════════════════════════════════
#  ~/.zshrc — full-stack dev environment
#  Layout: PATH → history → plugins → completion → tool init → aliases
# ═══════════════════════════════════════════════════════════════════════════

# ── PATH ──────────────────────────────────────────────────────────────────
# Apple Silicon puts Homebrew in /opt/homebrew, Intel in /usr/local.
if [[ -x /opt/homebrew/bin/brew ]]; then
  export BREW_PREFIX=/opt/homebrew
elif [[ -x /usr/local/bin/brew ]]; then
  export BREW_PREFIX=/usr/local
fi
export PATH="$BREW_PREFIX/bin:$BREW_PREFIX/sbin:$PATH"
export PATH="$HOME/.local/bin:$PATH"                       # pipx / uv tools
export PATH="$HOME/dotfiles/bin:$PATH"                     # scripts kept in the dotfiles repo
export PATH="$HOME/go/bin:$PATH"                           # go install binaries
export PATH="$BREW_PREFIX/share/google-cloud-sdk/bin:$PATH"
# GNU coreutils/sed without the `g` prefix (matches Linux/CI behaviour)
export PATH="$BREW_PREFIX/opt/coreutils/libexec/gnubin:$PATH"
export PATH="$BREW_PREFIX/opt/gnu-sed/libexec/gnubin:$PATH"

export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"
export LESS="-R"

# ── History ───────────────────────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY          # timestamp each entry
setopt SHARE_HISTORY             # sync history across open panes live
setopt HIST_IGNORE_ALL_DUPS      # keep only the most recent copy of a command
setopt HIST_IGNORE_SPACE         # a leading space keeps it out of history
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY               # expand !! for review instead of running it
setopt INC_APPEND_HISTORY

# ── Shell behaviour ───────────────────────────────────────────────────────
setopt AUTO_CD                   # `myrepo` instead of `cd myrepo`
setopt AUTO_PUSHD                # every cd pushes to the dir stack
setopt PUSHD_IGNORE_DUPS
setopt EXTENDED_GLOB
setopt INTERACTIVE_COMMENTS      # allow # comments when typing commands
setopt NO_BEEP

# ── Plugins (antidote) ────────────────────────────────────────────────────
zsh_plugins_txt="$HOME/.zsh_plugins.txt"
zsh_plugins_zsh="$HOME/.zsh_plugins.zsh"
source $BREW_PREFIX/opt/antidote/share/antidote/antidote.zsh
# Recompile the static plugin file only when the manifest changes — keeps
# startup near-instant instead of re-resolving plugins on every shell.
if [[ ! -f $zsh_plugins_zsh || $zsh_plugins_txt -nt $zsh_plugins_zsh ]]; then
  antidote bundle < "$zsh_plugins_txt" > "$zsh_plugins_zsh"
fi

# Oh My Zsh plugins cache their generated completions under $ZSH_CACHE_DIR.
# We use those plugins without installing OMZ itself, so nothing else sets it —
# unset, the gh/docker plugins try to write to /completions and fail.
export ZSH_CACHE_DIR="$HOME/.cache/oh-my-zsh"
[[ -d $ZSH_CACHE_DIR/completions ]] || mkdir -p "$ZSH_CACHE_DIR/completions"

# ── Completion ────────────────────────────────────────────────────────────
# compinit must run *before* the plugins below: the Oh My Zsh ones call
# `compdef` as they are sourced. zsh-completions therefore needs its fpath
# entry added by hand here rather than by the bundle.
fpath=("$ZSH_CACHE_DIR/completions" "$(antidote home)/github.com/zsh-users/zsh-completions/src" $fpath)
autoload -Uz compinit
# Only rebuild the completion dump once a day, not on every shell start.
if [[ -n $HOME/.zcompdump(#qN.mh+24) ]]; then compinit; else compinit -C; fi
autoload -Uz bashcompinit && bashcompinit

source "$zsh_plugins_zsh"

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu no                      # fzf-tab replaces the menu
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:complete:*:*' fzf-preview '[[ -f $realpath ]] && bat --color=always --line-range=:80 $realpath 2>/dev/null || eza -1 --color=always $realpath 2>/dev/null'
zstyle ':fzf-tab:*' switch-group '<' '>'

# ── Key bindings ──────────────────────────────────────────────────────────
bindkey -e                                          # emacs keys
bindkey '^[[A' history-substring-search-up          # ↑ searches what you typed
bindkey '^[[B' history-substring-search-down
bindkey '^[[1;3D' backward-word                     # ⌥←
bindkey '^[[1;3C' forward-word                      # ⌥→
bindkey '^[^?'   backward-kill-word                 # ⌥⌫

# ── Tool initialisation ───────────────────────────────────────────────────
eval "$(starship init zsh)"                         # prompt
eval "$(fnm env --use-on-cd --shell zsh)"           # auto-switch Node per .nvmrc
eval "$(zoxide init zsh)"                           # `z <dir>` frecency jump
eval "$(direnv hook zsh)"                           # per-project .envrc
eval "$(fzf --zsh)"                                 # ^R history, ^T files, ⌥C cd

export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 45% --layout=reverse --border=rounded --info=inline'
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range=:200 {}'"

# pyenv — only initialise the shims when pyenv is actually present
if command -v pyenv >/dev/null; then
  export PYENV_ROOT="$HOME/.pyenv"
  eval "$(pyenv init -)"
fi

export GOPATH="$HOME/go"
export DOCKER_CLI_HINTS=false

# ── Plugin tuning ─────────────────────────────────────────────────────────
# Suggest from history first, then from completions when history has nothing.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6c7086'   # dim grey, readable but not loud
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20             # don't suggest on huge pastes
bindkey '^ ' autosuggest-accept                # ctrl-space accepts the whole suggestion
bindkey '^[[1;5C' forward-word                 # ctrl-→ accepts one word of it

# you-should-use: remind me an alias exists, after the command runs
export YSU_MESSAGE_POSITION="after"
export YSU_MODE=BESTMATCH
export YSU_MESSAGE_FORMAT="$(printf '\033[2m')alias available: %alias$(printf '\033[0m')"

# magic-enter: what a bare Enter runs
MAGIC_ENTER_GIT_COMMAND='git status -sb'
MAGIC_ENTER_OTHER_COMMAND='ls'

# ── Aliases ───────────────────────────────────────────────────────────────
alias ls='eza --group-directories-first'
alias ll='eza -lah --group-directories-first --git'
alias lt='eza --tree --level=2'
alias cat='bat --paging=never'
alias vim='nvim'
alias v='nvim'
alias lg='lazygit'
alias ld='lazydocker'
alias rgh='rg --hidden --no-ignore'  # search ignored+hidden files too
alias df='df -h'
alias du='du -h'
alias ip='ipconfig getifaddr en0'
alias ports='lsof -iTCP -sTCP:LISTEN -n -P'
alias reload='exec zsh'
alias zshrc='$EDITOR ~/.zshrc'

# git
alias gs='git status -sb'
alias gd='git diff'
alias gds='git diff --staged'
alias gp='git push'
alias gpl='git pull --rebase'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gl='git log --oneline --graph --decorate -20'
alias gwip='git add -A && git commit -m "wip" --no-verify'
alias gundo='git reset --soft HEAD~1'

# package managers — run whichever the repo declares
alias ni='pnpm install'
alias nr='pnpm run'
alias nd='pnpm run dev'
alias nb='pnpm run build'
alias nt='pnpm test'

# docker via colima
alias dps='docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"'
alias dcu='docker compose up -d'
alias dcd='docker compose down'
alias dcl='docker compose logs -f'
alias colup='colima start --cpu 4 --memory 8 --disk 60'

# ── Functions ─────────────────────────────────────────────────────────────
# mkcd — make a directory and step into it
mkcd() { mkdir -p "$1" && cd "$1"; }

# killport — free up a port a dev server is squatting on
killport() { lsof -ti tcp:"$1" | xargs -r kill -9 && echo "freed port $1"; }

# gclone — clone and cd in one step
gclone() { git clone "$1" && cd "$(basename "$1" .git)"; }

# f — fuzzy-find a file and open it in the editor
f() { local file; file=$(fzf --preview 'bat --color=always {}') && $EDITOR "$file"; }
# ── Trending GitHub repos: keep the cache warm ────────────────────────────
# gh-trending writes ~/.cache/gh-trending.names, which claude-statusline reads
# on every refresh. Nothing renders the repos in the shell any more — the
# iTerm2 SetUserVar hook is gone — but the cache still needs refreshing.
_gh_trending_cache=~/.cache/gh-trending.names
if [[ ! -f $_gh_trending_cache || -n $_gh_trending_cache(#qN.mh+6) ]]; then
  (gh-trending --refresh >/dev/null 2>&1 &) 2>/dev/null
fi

alias trending='gh-trending --list | less -R'
alias trending-open='open "$(gh-trending --url)"'
# ── Ralph (autonomous Claude Code loops) ─────────────────────────────────────
# Installed to ~/.ralph with wrappers in ~/.local/bin (already on PATH above),
# so nothing here is needed to RUN it. This block exists to say where it lives
# and to record one deliberate omission.
#
# Ralph reads CLAUDE_MODEL, CLAUDE_EFFORT, CLAUDE_TIMEOUT_MINUTES,
# CLAUDE_OUTPUT_FORMAT and CLAUDE_CODE_CMD from the environment. They are NOT
# exported here on purpose: those names are generic enough to be picked up by
# interactive Claude Code too, so a global default here would quietly change
# every session, not just Ralph's loops. Per-project settings belong in that
# project's `.ralphrc`, which is where Ralph looks for them.
#
#   ralph-enable        # opt this project in (writes .ralph/ + .ralphrc)
#   ralph --monitor     # run the loop with the dashboard
#   ralph --dry-run     # simulate the loop without spending API calls
#   ralph-stats         # what the last runs cost
export RALPH_HOME="$HOME/.ralph"

# ── Remote Claude (claude.ai/code and the mobile app) ────────────────────────
# Remote Control is already on for every session: `remoteControlAtStartup` in
# claude/settings.json starts the bridge automatically, so plain `claude` is
# reachable from the Code tab in the Claude mobile app and from claude.ai/code.
# Nothing below is needed to get that. `claude doctor` prints a Remote Control
# section if the connection will not come up.
#
# What these two add is power, not reach. Claude Code keeps the machine awake
# while it is working - it spawns `caffeinate -i -t 300` and renews it - but
# that assertion is *idle system sleep* only: it dies with the session, lets
# the display sleep, and does not survive a closed lid. There is also no
# always-on service to fall back on; `claude daemon` reports "Service install
# is disabled in this version - the daemon runs on demand and exits when the
# last client disconnects". So a session you walk away from on a LAPTOP needs
# a wider assertion underneath it. On a desktop (no lid, always on mains) the
# default is usually enough and neither of these is worth typing.
#
#   claude-remote [name]   # session + display/system/idle sleep held off
#   lid-awake [on|off]     # also survive a closed lid (sudo, persistent)
#
# Both still need a session you started. To start work FROM the phone with
# nothing running here, install the persistent server as a login agent:
# `claude-remote-service install <dir>` (bin/, documented in the README).

# -d display, -i idle system sleep, -s system sleep. The assertion lasts
# exactly as long as the session: caffeinate releases it when claude exits.
claude-remote() {
  caffeinate -dis claude --remote-control "$@"
}

# Closed-lid sleep is not a power assertion, so caffeinate cannot hold it off.
# The override is `disablesleep`, which is undocumented (absent from pmset's
# man page and from `pmset -g custom`), persistent, and applies system-wide to
# every power source — so this is a command you run deliberately, never
# something install.sh does. It is verified after the fact rather than assumed,
# because an unsupported key is accepted silently on some releases.
lid-awake() {
  case "$1" in
    on|off)
      local want=$([[ $1 == on ]] && echo 1 || echo 0)
      sudo pmset -a disablesleep "$want" || return
      if pmset -g | grep -qE "disablesleep[[:space:]]+$want"; then
        print -r -- "lid-awake $1: closed-lid sleep $([[ $want == 1 ]] && echo disabled || echo restored)"
      else
        print -r -- "lid-awake $1: pmset accepted it but 'disablesleep' is not reported back"
        print -r -- "  This macOS does not support the key. Keep the lid open, or use"
        print -r -- "  clamshell mode with an external display and power attached."
      fi
      ;;
    *)
      pmset -g | grep -iE 'disablesleep' || print -r -- "disablesleep: not set (closed lid will sleep)"
      ;;
  esac
}

# ── Local overrides (machine-specific, not committed anywhere) ────────────
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
