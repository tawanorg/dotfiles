# Identity lives in ~/.gitconfig.local so this file can be shared publicly.
[include]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main

[core]
	editor = nvim
	pager = delta
	excludesfile = ~/.gitignore_global
	autocrlf = input

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true          # n / N to jump between diff hunks
	line-numbers = true
	side-by-side = false
	hyperlinks = true

[merge]
	conflictstyle = zdiff3   # shows the common ancestor in conflicts

[diff]
	algorithm = histogram
	colorMoved = default

[pull]
	rebase = true

[push]
	autoSetupRemote = true   # `git push` on a new branch just works
	followTags = true

# Clone GitHub over HTTPS (works before SSH keys exist on a fresh machine),
# but always push over SSH, so pushing never prompts for a password.
[url "git@github.com:"]
	pushInsteadOf = https://github.com/

[fetch]
	prune = true             # drop local refs for deleted remote branches

[rebase]
	autoStash = true
	autoSquash = true

[rerere]
	enabled = true           # remember how you resolved a conflict before

[branch]
	sort = -committerdate

[column]
	ui = auto

[alias]
	s = status -sb
	co = checkout
	cb = checkout -b
	br = branch
	ci = commit
	amend = commit --amend --no-edit
	unstage = reset HEAD --
	last = log -1 HEAD --stat
	lg = log --graph --pretty=format:'%C(auto)%h%d %s %C(dim)(%cr) <%an>' --abbrev-commit
	sync = !git pull --rebase && git push
	cleanup = "!git branch --merged | grep -v -E '^\\*|main|master|develop' | xargs -r git branch -d"
	uncommit = reset --soft HEAD~1
