#!/usr/bin/env python3
"""Restore generated Claude links; optionally install their upstream skills."""
import argparse
import json
from pathlib import Path
import shutil
import subprocess

ROOT = Path(__file__).resolve().parents[1]


def mirrors(dest, source):
    """True when dest is a byte-identical copy of the pooled skill.

    `skills add` symlinks into ~/.claude/skills only when it recognises the
    agent directory. Under a non-standard CLAUDE_CONFIG_DIR it populates
    ~/.agents/skills and then *copies* into the agent directory, clobbering
    the link. Such a copy carries nothing the pool does not, so it is safe to
    replace; a directory that differs is a real local skill and is preserved.
    """
    files = {p.relative_to(dest) for p in dest.rglob("*") if p.is_file()}
    if files != {p.relative_to(source) for p in source.rglob("*") if p.is_file()}:
        return False
    return all((dest / f).read_bytes() == (source / f).read_bytes() for f in files)


def restore(root, home, external=False):
    sources = json.loads((root / "claude/external.json").read_text())["shared_skills"]
    if external:
        for source, names in sources.items():
            subprocess.run(["npx", "-y", "skills", "add", source, "--full-depth",
                            "--skill", *names, "--agent", "claude-code", "-g", "-y"],
                           check=True, cwd=home)
    linked, missing = 0, []
    for names in sources.values():
        for name in names:
            if Path(name).name != name or name in (".", ".."):
                raise ValueError("Invalid skill name")
            source = home / ".agents/skills" / name
            dest = root / "claude/skills" / name
            if not (source / "SKILL.md").is_file():
                missing.append(name)
                continue
            if dest.is_symlink():
                if dest.resolve() == source.resolve():
                    linked += 1
                    continue
                dest.unlink()
            elif dest.is_dir():
                if not mirrors(dest, source):
                    raise FileExistsError(f"Preserving local skill directory: {dest}")
                shutil.rmtree(dest)
            elif dest.exists():
                raise FileExistsError(f"Preserving local skill directory: {dest}")
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.symlink_to(source)
            linked += 1
    print(f"Linked {linked} shared Claude skills")
    if missing:
        print("Missing upstream skills (restore with --external): " + ", ".join(missing))
    return missing


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--external", action="store_true")
    args = parser.parse_args()
    restore(ROOT, Path.home(), args.external)
