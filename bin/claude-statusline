#!/usr/bin/env bash
# Claude Code status line.
#
# Row 1: session health — model, effort, dir/branch, context left, cost, limits
# Row 2: trending open-source repos (clickable)
#
# Runs on every refresh, so it stays in bash+jq: one jq call, no decoding.
# Field names come from the real payload Claude Code sends on stdin.
input=$(cat)

IFS=$'\t' read -r model dir ctx cost rl5 rl7 effort added removed <<<"$(jq -r '
  [ (.model.display_name // "claude"),
    (.workspace.current_dir // .cwd // "-"),
    (.context_window.remaining_percentage // -1),
    (.cost.total_cost_usd // -1),
    (.rate_limits.five_hour.used_percentage // -1),
    (.rate_limits.seven_day.used_percentage // -1),
    (.effort.level // "-"),
    (.cost.total_lines_added // 0),
    (.cost.total_lines_removed // 0)
  ] | @tsv' <<<"$input")"

[[ $dir    == "-" ]] && dir=""
[[ $effort == "-" ]] && effort=""
model="${model/ (1M context)/ 1M}"          # keep the 1M hint without the width
short_dir="${dir/#$HOME/\~}"

branch=""
if [[ -n $dir ]] && b=$(git -C "$dir" branch --show-current 2>/dev/null) && [[ -n $b ]]; then
  branch="$b"
fi

E=$'\033'
CYAN="${E}[36m"; DIM="${E}[2m"; YEL="${E}[33m"; MAG="${E}[35m"
GRN="${E}[32m"; RED="${E}[31m"; OFF="${E}[0m"

# Colour by headroom: green while comfortable, yellow when worth noticing,
# red when it needs action (compact the context / limits about to bite).
ctx_colour() { local v=$1; (( v < 0 )) && return; if   (( v <= 15 )); then printf '%s' "$RED"
              elif (( v <= 35 )); then printf '%s' "$YEL"; else printf '%s' "$GRN"; fi; }
lim_colour() { local v=$1; if   (( v >= 90 )); then printf '%s' "$RED"
              elif (( v >= 70 )); then printf '%s' "$YEL"; else printf '%s' "$DIM"; fi; }

sep="${DIM}  ·  ${OFF}"
row1="${CYAN}${model}${OFF}"
[[ -n $effort ]] && row1+=" ${DIM}${effort}${OFF}"
if [[ -n $short_dir ]]; then
  row1+="${sep}${DIM}${short_dir}${OFF}"
  [[ -n $branch ]] && row1+=" ${MAG}${branch}${OFF}"
fi

# Context remaining — the number that decides when to /compact.
if (( ctx >= 0 )); then
  row1+="${sep}$(ctx_colour "$ctx")ctx ${ctx}%${OFF}"
fi

if [[ $cost != "-1" ]]; then
  row1+="${sep}${DIM}\$$(printf '%.2f' "$cost")${OFF}"
fi

if (( added > 0 || removed > 0 )); then
  row1+="${sep}${GRN}+${added}${OFF}${DIM}/${OFF}${RED}-${removed}${OFF}"
fi

# Rate limits: how much of the 5-hour and weekly budget is already spent.
limits=""
(( rl5 >= 0 )) && limits+="$(lim_colour "$rl5")5h ${rl5}%${OFF}"
(( rl7 >= 0 )) && { [[ -n $limits ]] && limits+="${DIM} ${OFF}"; limits+="$(lim_colour "$rl7")7d ${rl7}%${OFF}"; }
[[ -n $limits ]] && row1+="${sep}${limits}"

# ── Row 2: trending repos, rotating every 30 minutes ──────────────────────
NAMES="$HOME/.cache/gh-trending.names"
GROUP=5
ROTATE=1800

row2=""
if [[ -r $NAMES ]]; then
  total=$(grep -c . "$NAMES" 2>/dev/null || echo 0)
  if (( total > 0 )); then
    groups=$(( (total + GROUP - 1) / GROUP ))
    g=$(( ($(date +%s) / ROTATE) % groups ))
    start=$(( g * GROUP + 1 ))
    rsep=""
    while IFS= read -r name; do
      [[ -z $name ]] && continue
      row2+="${rsep}${E}]8;;https://github.com/${name}${E}\\${YEL}${name}${OFF}${E}]8;;${E}\\"
      rsep="${DIM} / ${OFF}"
    done < <(sed -n "${start},$((start + GROUP - 1))p" "$NAMES")
  fi
fi

printf '%s\n' "$row1"
[[ -n $row2 ]] && printf '%s\n' "$row2"
