#!/usr/bin/env bash
# Claude Code status line. Reads session JSON on stdin, prints one line.
# Runs on every refresh, so it stays in bash+jq and does no decoding: the
# cache files are pre-rendered by gh-trending.
input=$(cat)

# Tab-separated, split on tab only — model names contain spaces ("Opus 5").
IFS=$'\t' read -r model dir <<<"$(jq -r '[(.model.display_name // "claude"),
                                          (.workspace.current_dir // .cwd // "")]
                                         | @tsv' <<<"$input")"

short_dir="${dir/#$HOME/\~}"

branch=""
if [[ -n $dir ]] && b=$(git -C "$dir" branch --show-current 2>/dev/null) && [[ -n $b ]]; then
  branch="$b"
fi

E=$'\033'
CYAN="${E}[36m"; DIM="${E}[2m"; YEL="${E}[33m"; MAG="${E}[35m"; OFF="${E}[0m"

out="${CYAN}${model}${OFF} ${DIM}${short_dir}${OFF}"
[[ -n $branch ]] && out+=" ${MAG}${branch}${OFF}"

# ── Trending repos ────────────────────────────────────────────────────────
# GROUP repos advance once every ROTATE seconds, keyed off the wall clock so
# the line is stable between refreshes and needs no stored state.
NAMES="$HOME/.cache/gh-trending.names"
GROUP=5
ROTATE=1800          # 30 minutes

if [[ -r $NAMES ]]; then
  total=$(grep -c . "$NAMES" 2>/dev/null || echo 0)
  if (( total > 0 )); then
    groups=$(( (total + GROUP - 1) / GROUP ))
    g=$(( ($(date +%s) / ROTATE) % groups ))
    start=$(( g * GROUP + 1 ))
    # Plain gap before the first repo so the branch doesn't read as part of
    # the list; " / " between repos thereafter.
    sep="  "
    while IFS= read -r name; do
      [[ -z $name ]] && continue
      # OSC 8 hyperlink; the URL is always github.com/<owner>/<repo>
      link_open="${E}]8;;https://github.com/${name}${E}\\"
      link_close="${E}]8;;${E}\\"
      out+="${sep}${link_open}${YEL}${name}${OFF}${link_close}"
      sep="${DIM} / ${OFF}"
    done < <(sed -n "${start},$((start + GROUP - 1))p" "$NAMES")
  fi
fi

printf '%s\n' "$out"
