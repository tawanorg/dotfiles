#!/usr/bin/env python3
"""Fetch interesting self-hosted / AI / dev-tooling repos from GitHub and
rotate through them one at a time, for display in a status bar.

  gh-trending --refresh   force a fetch
  gh-trending --next      print the next repo (refreshes in background if stale)
  gh-trending --list      print everything cached
"""
import json, os, sys, time, urllib.request, urllib.error, urllib.parse, subprocess, random

CACHE = os.path.expanduser("~/.cache/gh-trending.json")
LINES  = os.path.expanduser("~/.cache/gh-trending.lines")
NAMES  = os.path.expanduser("~/.cache/gh-trending.names")
GROUPS = os.path.expanduser("~/.cache/gh-trending.groups")
GROUP_SIZE = 5
MAX_AGE = 6 * 3600          # refetch at most every 6 hours
API = "https://api.github.com/search/repositories"

def _days_ago(n):
    return time.strftime("%Y-%m-%d", time.gmtime(time.time() - n * 86400))

# Each query is (label, search string). Mixing "new and rising" with
# "established but actively pushed" keeps the rotation from going stale.
QUERIES = [
    ("self-hosted", f"topic:self-hosted stars:>300 pushed:>{_days_ago(60)}"),
    ("self-hosted", f"topic:self-hosted stars:>50 created:>{_days_ago(365)}"),
    ("ai",          f"topic:llm stars:>500 pushed:>{_days_ago(30)}"),
    ("ai",          f"topic:ai-agents stars:>100 created:>{_days_ago(270)}"),
    ("mcp",         f"topic:mcp stars:>100 pushed:>{_days_ago(60)}"),
    ("devtools",    f"topic:developer-tools stars:>800 pushed:>{_days_ago(30)}"),
]

def _token():
    """Use the gh CLI's token when it's logged in — 5000 req/hr instead of 10/min."""
    try:
        out = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    except Exception:
        pass
    return os.environ.get("GITHUB_TOKEN") or None

def _clean(text):
    """Collapse any whitespace run to a single space.

    A status bar is one line: a newline or tab in a repo description would
    break the SetUserVar payload, and GitHub does allow both.
    """
    return " ".join((text or "").split())

def _search(q, token):
    url = f"{API}?{urllib.parse.urlencode({'q': q, 'sort': 'stars', 'order': 'desc', 'per_page': 25})}"
    req = urllib.request.Request(url, headers={
        "Accept": "application/vnd.github+json",
        "User-Agent": "gh-trending",
        **({"Authorization": f"Bearer {token}"} if token else {}),
    })
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.load(r).get("items", [])

def refresh():
    token, repos, seen = _token(), [], set()
    for label, q in QUERIES:
        try:
            items = _search(q, token)
        except urllib.error.HTTPError as e:
            if e.code in (403, 429):      # rate limited — keep whatever we already have
                break
            continue
        except Exception:
            continue
        for it in items:
            name = it["full_name"]
            if name in seen or it.get("archived") or it.get("fork"):
                continue
            seen.add(name)
            repos.append({
                "name": name,
                "stars": it["stargazers_count"],
                "desc": _clean(it.get("description")),
                "url": it["html_url"],
                "topic": label,
            })
        if not token:
            time.sleep(2)                 # unauthenticated search allows 10/min
    if not repos:
        return _load().get("repos", [])
    random.shuffle(repos)                 # avoid always leading with the same giants
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    tmp = CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"fetched": time.time(), "idx": 0, "repos": repos}, f)
    os.replace(tmp, CACHE)                # atomic: a concurrent --next never sees a half file
    _write_lines(repos)
    return repos

def _write_lines(repos):
    """Pre-render every form a consumer might need, so display costs nothing.

    .names  plain owner/repo, one per line   -> claude-statusline (sed, no decode)
    .groups base64 of GROUP_SIZE names joined -> iTerm2 user var (printf only)

    Groups are precomputed because the zsh prompt hook cannot join or base64
    anything without spawning a process.
    """
    import base64
    names = [r["name"] for r in repos]

    def _atomic(path, text):
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write(text)
        os.replace(tmp, path)

    _atomic(NAMES, "\n".join(names) + "\n")
    _atomic(LINES, "\n".join(base64.b64encode(n.encode()).decode() for n in names) + "\n")

    groups = []
    for i in range(0, len(names), GROUP_SIZE):
        chunk = names[i:i + GROUP_SIZE]
        if len(chunk) < GROUP_SIZE and len(names) >= GROUP_SIZE:
            chunk = (chunk + names)[:GROUP_SIZE]      # wrap rather than show a short group
        groups.append(base64.b64encode(" / ".join(chunk).encode()).decode())
    _atomic(GROUPS, "\n".join(groups) + "\n")

def _load():
    try:
        with open(CACHE) as f:
            return json.load(f)
    except Exception:
        return {}

def _fmt(r):
    """Status-bar form: just owner/repo.

    The URL is always https://github.com/<full_name>, so consumers can rebuild
    the link from this alone — no second field to keep in sync.
    """
    return r["name"]

def _fmt_full(r):
    """Verbose form for `trending`, which pages through the list."""
    stars = f"{r['stars']/1000:.1f}k" if r["stars"] >= 1000 else str(r["stars"])
    desc = r["desc"]
    if len(desc) > 62:
        desc = desc[:61].rstrip() + "…"
    return f"★{stars:>7} {r['name']}" + (f" — {desc}" if desc else "")

def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "--next"
    if arg == "--refresh":
        print(f"cached {len(refresh())} repos"); return
    data = _load()
    stale = time.time() - data.get("fetched", 0) > MAX_AGE
    if not data.get("repos"):
        data = {"repos": refresh(), "idx": 0, "fetched": time.time()}
        if not data["repos"]:
            return
    elif stale:
        # Refresh out of band so the prompt never blocks on the network.
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--refresh"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    repos = data["repos"]
    if arg == "--lines":
        _write_lines(repos); print(f"wrote {len(repos)} lines to {LINES}"); return
    if arg == "--list":
        for r in repos: print(_fmt_full(r))
        return
    if arg == "--url":
        print(repos[data.get("idx", 0) % len(repos)]["url"]); return
    idx = data.get("idx", 0) % len(repos)
    print(_fmt(repos[idx]))
    data["idx"] = (idx + 1) % len(repos)
    try:
        with open(CACHE, "w") as f: json.dump(data, f)
    except Exception:
        pass

if __name__ == "__main__":
    main()
